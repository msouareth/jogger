          {
            "type": "color",
            "id": "accent",
            "label": "t:settings.palette.accent",
            "info": "t:settings.palette.accent_info",
            "default": "#8a6f52"
          },
          {
            "type": "color",
            "id": "accent_2",
            "label": "t:settings.palette.accent_2",
            "info": "t:settings.palette.accent_2_info",
            "default": "#8e9b87"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:settings.palette.button",
            "info": "t:settings.palette.button_info",
            "default": "#2b2621"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:settings.palette.button_label",
            "default": "#faf7f2"
          },
          {
            "type": "color",
            "id": "button_hover",
            "label": "t:settings.palette.button_hover",
            "default": "#5f4c37"
          }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text",
          "links": "accent",
          "icons": "text"
        }
      },
      {
        "type": "range",
        "id": "divider_opacity",
        "label": "t:settings.palette.divider_opacity",
        "min": 4,
        "max": 30,
        "step": 1,
        "unit": "%",
        "default": 13
      }
    ]
  },
