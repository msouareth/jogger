<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- comment -%}
      The tint a phone paints its browser chrome with, so it meets the page
      rather than fighting it. In dark mode the ground is the scheme's text
      colour, the two having traded places.
    {%- endcomment -%}
    <meta name="theme-color" content="{% if settings.color_mode == 'dark' %}{{ settings.color_schemes.first.settings.text }}{% else %}{{ settings.color_schemes.first.settings.background }}{% endif %}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>

    {% render 'meta-tags' %}
    {{ content_for_header }}

    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ settings.type_heading_font | font_face: font_display: 'swap' }}

      {% render 'css-variables' %}
    {% endstyle %}

    {{ 'jogger.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body class="template--password">
    {{ content_for_layout }}
  </body>
</html>
