{% layout none %}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'gift_cards.issued.title' | t: value: gift_card.initial_value, shop: shop.name }}</title>

    {{ content_for_header }}

    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ settings.type_heading_font | font_face: font_display: 'swap' }}

      {% render 'css-variables' %}

      .gc {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: var(--edge);
      }

      .gc-inner {
        display: grid;
        gap: 22px;
        justify-items: center;
        text-align: center;
        max-width: 46ch;
      }

      .gc-code {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        background: var(--color-surface);
        border-radius: var(--r);
        padding: 16px 22px;
        font-size: 19px;
        letter-spacing: 0.14em;
      }

      .gc-qr {
        padding: 14px;
        background: var(--color-surface);
        border-radius: var(--r);
      }

      @media print {
        .gc-noprint { display: none; }
      }
    {% endstyle %}

    {{ 'mundo.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="template--gift-card">
    <div class="gc">
      <div class="gc-inner">
        <p class="dsp" style="font-size: calc(clamp(26px, 3.4vw, 44px) * var(--type-scale));">
          {{- shop.name | escape -}}
        </p>

        <h1 class="h2">
          {{ 'gift_cards.issued.title' | t: value: gift_card.initial_value, shop: shop.name }}
        </h1>

        <p class="body" style="margin: 0 auto;">{{ 'gift_cards.issued.subtext' | t }}</p>

        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="form-error">{{ 'gift_cards.issued.expires' | t: expiry: gift_card.expires_on }}</p>
        {%- endif -%}

        <div class="gc-qr">
          {{ gift_card.qr_identifier }}
        </div>

        <div class="gc-code">
          <span>{{ gift_card.code | format_code }}</span>
          <button
            type="button"
            class="b b-ghost gc-noprint"
            onclick="navigator.clipboard.writeText({{ gift_card.code | json }}); this.textContent = {{ 'gift_cards.issued.copied' | t | json }};"
          >
            {{ 'gift_cards.issued.copy_code' | t }}
          </button>
        </div>

        {%- if gift_card.balance != gift_card.initial_value -%}
          <p class="form-note">
            {%- assign balance = gift_card.balance | money -%}
            {{ 'gift_cards.issued.remaining' | t: balance: balance }}
          </p>
        {%- endif -%}

        <div class="gc-noprint" style="display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;">
          <a class="b b-solid" href="{{ shop.url }}">
            {{ 'gift_cards.issued.shop_link' | t }}
            <span class="ar">&rarr;</span>
          </a>
          <button type="button" class="b b-line" onclick="window.print()">
            {{ 'gift_cards.issued.print' | t }}
          </button>
        </div>
      </div>
    </div>
  </body>
</html>
