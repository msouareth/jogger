{%- comment -%}
  Single-source icon set. Accepts:
  - name {String}  heart, close, search, account, bag, caret, arrow, minus,
                   plus, instagram, tiktok, pinterest, facebook, youtube

  The line icons (close, search, account, bag, caret) are drawn on the same
  24px grid at stroke-width 1.4 so they sit together on a row without one
  reading heavier than the rest. They inherit currentColor, which is what lets
  the header flip them to light over a hero and back again once it sticks.
{%- endcomment -%}

{%- case name -%}
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 20.5S3.5 14.9 3.5 9.3A4.8 4.8 0 0 1 12 6.6a4.8 4.8 0 0 1 8.5 2.7c0 5.6-8.5 11.2-8.5 11.2Z"/>
    </svg>
  {%- when 'close' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.4">
      <path d="M5 5l14 14M19 5L5 19"/>
    </svg>
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.4">
      <circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>
    </svg>
  {%- when 'account' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.4">
      <circle cx="12" cy="8.4" r="3.7"/><path d="M4.8 20.3c0-3.55 3.23-6.1 7.2-6.1s7.2 2.55 7.2 6.1"/>
    </svg>
  {%- when 'bag' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.4">
      <path d="M5.4 7.7h13.2l.95 12.6H4.45L5.4 7.7Z"/><path d="M8.9 9.6V6.9a3.1 3.1 0 0 1 6.2 0v2.7"/>
    </svg>
  {%- when 'caret' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M6.5 9.75 12 15l5.5-5.25"/>
    </svg>
  {%- when 'arrow' -%}
    <span class="ar" aria-hidden="true">&rarr;</span>
  {%- when 'minus' -%}
    <span aria-hidden="true">&minus;</span>
  {%- when 'plus' -%}
    <span aria-hidden="true">+</span>
  {%- when 'instagram' -%}
