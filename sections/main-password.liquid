<div class="pw">
  <div class="pw-inner">
    {%- if section.settings.logo != blank -%}
      <img
        src="{{ section.settings.logo | image_url: width: 400 }}"
        alt="{{ shop.name | escape }}"
        width="{{ section.settings.logo.width }}"
        height="{{ section.settings.logo.height }}"
        style="width: {{ section.settings.logo_width }}px; height: auto;"
      >
    {%- else -%}
      <p class="dsp" style="font-size: calc(clamp(30px, 4vw, 54px) * var(--type-scale));">
        {{- shop.name | escape -}}
      </p>
    {%- endif -%}

    <h1 class="lab">{{ section.settings.heading | default: 'Opening soon' | escape }}</h1>

    {%- if section.settings.body != blank -%}
      <div class="body rte" style="margin: 0 auto;">{{ section.settings.body }}</div>
    {%- else -%}
      <p class="body" style="margin: 0 auto;">{{ 'general.password.message' | t }}</p>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      <label class="visually-hidden" for="StorefrontPassword">{{ 'general.password.password' | t }}</label>
      <input
        type="password"
        id="StorefrontPassword"
        name="password"
        placeholder="{{ 'general.password.password' | t }}"
        autocomplete="current-password"
        required
      >
      <button type="submit" class="b b-ghost">
        {{ 'general.password.submit' | t }}
        <span class="ar">&rarr;</span>
      </button>

      {%- if form.errors -%}
        <p class="form-error">{{ 'general.password.error' | t }}</p>
      {%- endif -%}
    {%- endform -%}

    <p class="form-note">
      {{ 'general.password.admin' | t }}
      <a href="/admin">{{ 'general.password.login' | t }}</a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "richtext", "id": "body", "label": "Text" }
  ],
  "enabled_on": {
    "templates": ["password"]
  }
}
{% endschema %}
