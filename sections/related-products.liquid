{%- comment -%}
  Products from the same category as the one being viewed.

  "Same category" resolves in this order: the collection the visitor arrived
  through, then the product's own first collection, then anything sharing its
  product type. Shopify's recommendation engine is available as an alternative,
  but it only works on its own route, so that mode ships empty and product.js
  fetches this section back to fill it.
{%- endcomment -%}

{%- liquid
  assign limit = section.settings.count
  assign source = section.settings.source

  comment
    Shopify keeps two curated lists against a product, and they mean different
    things: complementary is "goes with this", related is "similar to this".
    A row headed Complete the look wants the first, but the merchant picks,
    because the same section is also used as a plain "you may also like".
  endcomment
  assign intent = section.settings.intent | default: 'related'

  assign related = blank

  if source == 'recommendations'
    assign related = recommendations.products
  else
    assign pool = collection
    if pool == blank or pool.handle == blank
      assign pool = product.collections.first
    endif

    if pool != blank
      assign related = pool.products
    endif
  endif
-%}

<div class="scheme color-{{ section.settings.color_scheme }}">
  <div
    class="wrap"
    {% if source == 'recommendations' %}
      data-recommendations
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent={{ intent }}"
    {% endif %}
  >
    {%- comment -%}
      Count how many of the pool are actually showable — everything except
      the product already on screen — so the section can hide itself rather
      than render a lone heading.
    {%- endcomment -%}
    {%- assign showable = 0 -%}
    {%- for candidate in related -%}
      {%- if candidate.id != product.id -%}
        {%- assign showable = showable | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if showable > 0 -%}
      {%- if section.settings.heading != blank -%}
        {%- capture label_style %}{% render 'text-style', s: section.settings, key: 'label' %}{% endcapture -%}
        {%- capture heading_style %}{% render 'text-style', s: section.settings, key: 'heading' %}{% endcapture -%}
        <div class="shead shead--tight">
          <div>
            {%- if section.settings.label != blank -%}
              <p class="lab" style="{{ label_style }}">{{ section.settings.label | escape }}</p>
            {%- endif -%}
            <h2 class="h2" style="{{ heading_style }}">{{ section.settings.heading | escape }}</h2>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.layout == 'carousel' -%}
        <div class="rail-wrap">
          <div class="rail rail--cards">
            {%- assign shown = 0 -%}
            {%- for candidate in related -%}
              {%- if candidate.id == product.id -%}
                {%- continue -%}
              {%- endif -%}
              {%- if shown >= limit -%}
                {%- break -%}
              {%- endif -%}
              {% render 'product-card',
                product: candidate,
                index: shown,
                sizes: '(min-width: 1100px) 23vw, 60vw',
                style: 'tile'
              %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endfor -%}
          </div>

          <button type="button" class="rail-nav prev" data-rail-prev aria-label="{{ 'accessibility.previous' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <button type="button" class="rail-nav next" data-rail-next aria-label="{{ 'accessibility.next' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      {%- else -%}
        <div class="pgrid" style="--cols: {{ section.settings.columns }};">
          {%- assign shown = 0 -%}
          {%- for candidate in related -%}
            {%- if candidate.id == product.id -%}
              {%- continue -%}
            {%- endif -%}
            {%- if shown >= limit -%}
              {%- break -%}
            {%- endif -%}
            {% render 'product-card',
              product: candidate,
              index: shown,
              sizes: '(min-width: 1100px) 25vw, 50vw',
              style: 'tile'
            %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div style="height: clamp(56px, 8vw, 100px);"></div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "section-related",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete the look"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Which products",
      "options": [
        {
          "value": "collection",
          "label": "Same category"
        },
        {
          "value": "recommendations",
          "label": "Shopify recommendations"
        }
      ],
      "info": "Same category uses the collection the shopper came through, falling back to the product's own collection. Shopify recommendations is the only mode you can hand-pick per product — see below.",
      "default": "collection"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation list",
      "options": [
        {
          "value": "complementary",
          "label": "Complementary — goes with this"
        },
        {
          "value": "related",
          "label": "Related — similar to this"
        }
      ],
      "info": "Only applies when Which products is set to Shopify recommendations. These are the two lists in the free Search & Discovery app, set per product under Products › (a product) › Search & Discovery. Complementary is the hand-picked one — the pieces that finish an outfit — and is what a row headed 'Complete the look' wants. Related leans on Shopify's own similarity engine and needs no curation.",
      "default": "related"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "carousel",
          "label": "Carousel"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "info": "Grid layout only.",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "count",
      "label": "Products shown",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Label type"
    },
    {
      "type": "select",
      "id": "label_font",
      "label": "Font",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "heading",
          "label": "Heading font"
        },
        {
          "value": "body",
          "label": "Body font"
        },
        {
          "value": "accent",
          "label": "Accent font"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Size",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Colour",
      "info": "Leave empty to follow the colour scheme."
    },
    {
      "type": "header",
      "content": "Heading type"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Font",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "heading",
          "label": "Heading font"
        },
        {
          "value": "body",
          "label": "Body font"
        },
        {
          "value": "accent",
          "label": "Accent font"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Size",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Colour",
      "info": "Leave empty to follow the colour scheme."
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}
