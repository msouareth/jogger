<div class="scheme color-{{ section.settings.color_scheme }}">
  <div class="wrap">
    {%- capture label_style %}{% render 'text-style', s: section.settings, key: 'label' %}{% endcapture -%}
    {%- capture heading_style %}{% render 'text-style', s: section.settings, key: 'heading' %}{% endcapture -%}
    {%- capture hint_style %}{% render 'text-style', s: section.settings, key: 'hint' %}{% endcapture -%}

    {%- if section.settings.label != blank or section.settings.heading != blank -%}
      <div class="shead rv shead--tight">
        <div>
          {%- if section.settings.label != blank -%}
            <p class="lab" style="{{ label_style }}">{{ section.settings.label | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="h2" style="{{ heading_style }}">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.hint != blank -%}
          <p class="lab" style="letter-spacing: .1em;{{ hint_style }}">{{ section.settings.hint | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      Wrapped so the rail gets the same arrows the related products carousel
      uses — jogger.js binds them by class, so no new script is involved.

      Dragging alone was never enough. It is invisible unless you happen to try
      it, the hint saying so is only text and cannot be clicked, and a rail you
      can only drag is unreachable by keyboard entirely. Real buttons fix all
      three at once.
    {%- endcomment -%}
    {%- liquid
      comment
        The level rail is the original and adds nothing, so a stored lookbook
        that predates this setting keeps the design it already had.
      endcomment
      assign rail_class = 'rail'
      if section.settings.layout == 'stagger'
        assign rail_class = 'rail rail--stagger'
      endif
    -%}
    <div class="rail-wrap">
    <div
      class="{{ rail_class }}"
      style="--look-step: {{ section.settings.stagger | default: 48 }}px;"
      {%- if section.settings.drift %}
        data-drift
        data-drift-speed="{{ section.settings.drift_speed | default: 25 }}"
      {%- endif %}
    >
      {%- for block in section.blocks -%}
        <figure class="look" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a class="fr" href="{{ block.settings.link }}">
              {% render 'media',
                image: block.settings.image,
                sizes: '(min-width: 900px) 27vw, 70vw',
                placeholder: 'lifestyle-1'
              %}
            </a>
          {%- else -%}
            <span class="fr">
              {% render 'media',
                image: block.settings.image,
                sizes: '(min-width: 900px) 27vw, 70vw',
                placeholder: 'lifestyle-1'
              %}
            </span>
          {%- endif -%}

          {%- if block.settings.caption != blank -%}
            {%- capture caption_style %}{% render 'text-style', s: block.settings, key: 'caption' %}{% endcapture -%}
            <figcaption style="{{ caption_style }}">{{ block.settings.caption | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>

      {%- comment -%}
        Sat against the images rather than the captions beneath them, which is
        what --rail-nav-top is for.
      {%- endcomment -%}
      <button type="button" class="rail-nav prev" data-rail-prev aria-label="{{ 'accessibility.previous' | t }}" style="--rail-nav-top: 34%;">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
      </button>
      <button type="button" class="rail-nav next" data-rail-next aria-label="{{ 'accessibility.next' | t }}" style="--rail-nav-top: 34%;">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lookbook rail",
  "tag": "section",
  "class": "section-lookbook",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "info": "Level is the original: every card on the same line. Staggered steps them alternately down and up as the rail runs, which reads less like a filmstrip and more like a spread.",
      "options": [
        {
          "value": "level",
          "label": "Level — one straight line"
        },
        {
          "value": "stagger",
          "label": "Staggered — cards step down and up"
        }
      ],
      "default": "level"
    },
    {
      "type": "range",
      "id": "stagger",
      "label": "Step",
      "info": "How far the staggered cards move from the line — the first down, the next up, and so on. Halved on a phone, where the cards are narrow and the height is worth more. Has no effect on the level layout.",
      "min": 8,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "drift",
      "label": "Move on its own",
      "info": "The rail drifts steadily sideways and never reaches an end — the looks repeat, and the join cannot be seen. Dragging, flicking or the arrows take over at any moment, and it picks up again as soon as the visitor lets go. It stops for anyone who has asked their device for reduced motion, and while it is off screen.",
      "default": false
    },
    {
      "type": "range",
      "id": "drift_speed",
      "label": "Speed",
      "info": "Pixels a second. Around 25 reads as a slow drift; past 60 it starts to feel like it is being scrolled for you.",
      "min": 5,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "04 — Lookbook"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A/W 26 in the round"
    },
    {
      "type": "text",
      "id": "hint",
      "label": "Hint",
      "info": "Sits at the right of the heading row.",
      "default": "Drag to explore →"
    },
    {
      "type": "header",
      "content": "Label type"
    },
    {
      "type": "select",
      "id": "label_font",
      "label": "Font",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "heading",
          "label": "Heading font"
        },
        {
          "value": "body",
          "label": "Body font"
        },
        {
          "value": "accent",
          "label": "Accent font"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Size",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Colour",
      "info": "Leave empty to follow the colour scheme."
    },
    {
      "type": "header",
      "content": "Heading type"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Font",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "heading",
          "label": "Heading font"
        },
        {
          "value": "body",
          "label": "Body font"
        },
        {
          "value": "accent",
          "label": "Accent font"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Size",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Colour",
      "info": "Leave empty to follow the colour scheme."
    },
    {
      "type": "header",
      "content": "Hint type"
    },
    {
      "type": "select",
      "id": "hint_font",
      "label": "Font",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "heading",
          "label": "Heading font"
        },
        {
          "value": "body",
          "label": "Body font"
        },
        {
          "value": "accent",
          "label": "Accent font"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "hint_size",
      "label": "Size",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "hint_color",
      "label": "Colour",
      "info": "Leave empty to follow the colour scheme."
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
