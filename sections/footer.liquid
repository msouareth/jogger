<div class="scheme color-{{ section.settings.color_scheme }}">
  <div class="ftr">
    <div class="wrap cols">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div {{ block.shopify_attributes }}>
              <p class="mark">
                {%- if block.settings.logo != blank -%}
                  <img
                    src="{{ block.settings.logo | image_url: width: 400 }}"
                    alt="{{ shop.name | escape }}"
                    width="{{ block.settings.logo.width }}"
                    height="{{ block.settings.logo.height }}"
                    style="--logo-width: {{ block.settings.logo_width }}px;"
                  >
                {%- else -%}
                  {{- block.settings.text | default: shop.name | escape -}}
                  <b>{{ block.settings.text_light | escape }}</b>
                {%- endif -%}
              </p>

              {%- if block.settings.about != blank -%}
                {%- capture about_style %}{% render 'text-style', s: block.settings, key: 'about' %}{% endcapture -%}
                <p class="about" style="{{ about_style }}">{{ block.settings.about | escape }}</p>
              {%- endif -%}

              {% render 'social-icons' %}
            </div>

          {%- when 'menu' -%}
            {%- comment -%}
              A column with nothing in it is worse than no column: it leaves a
              heading standing over empty space and a gap in the row. That is
              what a merchant sees whenever the chosen menu has not been built
              yet, so on the storefront the whole block stands down.

              In the editor it does the opposite and says so, because a block
              that renders nothing is a block that cannot be selected to be
              fixed or removed.

              The links are assigned rather than reached through inline because
              a handle naming a menu the shop has not got resolves to nothing
              at all, and the count has to survive that — not merely an
              existing menu that happens to be empty.
            {%- endcomment -%}
            {%- liquid
              assign column_links = ''
              if block.settings.menu != blank
                assign column_links = block.settings.menu.links
              endif
            -%}
            {%- if column_links != blank and column_links.size > 0 -%}
              <div {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  {%- capture heading_style %}{% render 'text-style', s: block.settings, key: 'heading' %}{% endcapture -%}
                  <h5 style="{{ heading_style }}">{{ block.settings.heading | escape }}</h5>
                {%- endif -%}
                <ul>
                  {%- for link in column_links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- elsif request.design_mode -%}
              <div {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h5>{{ block.settings.heading | escape }}</h5>
                {%- endif -%}
                <p class="ftr-hint">{{ 'sections.footer.empty_menu' | t }}</p>
              </div>
            {%- endif -%}

          {%- when 'contact' -%}
            {%- comment -%}
              The phone and the email are links, not lines of text. On a phone a
              tel: link dials and a mailto: opens the mail app, which is the
              whole reason a shop puts a number in its footer; printed as plain
              text it would have to be copied out by hand.

              A dialable href cannot carry the spacing that makes a number
              readable, so the two are separated: the label keeps the merchant's
              own formatting and the href is stripped down to what a phone can
              actually dial.
            {%- endcomment -%}
            {%- liquid
              assign has_details = false
              if block.settings.address != blank
                assign has_details = true
              endif
              if block.settings.phone != blank or block.settings.phone_2 != blank
                assign has_details = true
              endif
              if block.settings.email != blank or block.settings.hours != blank
                assign has_details = true
              endif
            -%}
            {%- if has_details -%}
              <div {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  {%- capture heading_style %}{% render 'text-style', s: block.settings, key: 'heading' %}{% endcapture -%}
                  <h5 style="{{ heading_style }}">{{ block.settings.heading | escape }}</h5>
                {%- endif -%}

                <ul class="ftr-contact">
                  {%- if block.settings.address != blank -%}
                    <li>
                      <address>{{ block.settings.address | escape | newline_to_br }}</address>
                    </li>
                  {%- endif -%}

                  {%- comment -%}
                    Split first, loop second. A for tag takes a collection, not
                    an expression — a filter in that position is a parse error,
                    and a section that will not parse takes its schema down with
                    it, so every block type it defines reads as undefined.
                  {%- endcomment -%}
                  {%- assign phone_keys = 'phone,phone_2' | split: ',' -%}
                  {%- for key in phone_keys -%}
                    {%- assign number = block.settings[key] -%}
                    {%- if number != blank -%}
                      {%- assign dialable = number
                        | remove: ' '
                        | remove: '('
                        | remove: ')'
                        | remove: '-'
                        | remove: '.'
                        | remove: '/'
                      -%}
                      <li><a href="tel:{{ dialable }}">{{ number | escape }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}

                  {%- if block.settings.email != blank -%}
                    <li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email | escape }}</a></li>
                  {%- endif -%}

                  {%- if block.settings.hours != blank -%}
                    <li class="ftr-hours">{{ block.settings.hours | escape | newline_to_br }}</li>
                  {%- endif -%}
                </ul>
              </div>
            {%- elsif request.design_mode -%}
              <div {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h5>{{ block.settings.heading | escape }}</h5>
                {%- endif -%}
                <p class="ftr-hint">{{ 'sections.footer.empty_contact' | t }}</p>
              </div>
            {%- endif -%}

          {%- when 'text' -%}
            {%- comment -%}
              Held to the same rule as the menu column above, for the same
              reason: no words, no column.
            {%- endcomment -%}
            {%- if block.settings.body != blank -%}
              <div {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h5>{{ block.settings.heading | escape }}</h5>
                {%- endif -%}
                <div class="about rte">{{ block.settings.body }}</div>
              </div>
            {%- elsif request.design_mode -%}
              <div {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h5>{{ block.settings.heading | escape }}</h5>
                {%- endif -%}
                <p class="ftr-hint">{{ 'sections.footer.empty_text' | t }}</p>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="wrap">
      <div class="base">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>

        {%- if section.settings.tagline != blank -%}
          <span>{{ section.settings.tagline | escape }}</span>
        {%- endif -%}

        {%- if section.settings.show_locale_selectors -%}
          <div class="locale-forms">
            {%- if localization.available_countries.size > 1 -%}
              {%- form 'localization' -%}
                <label class="visually-hidden" for="FooterCountry">{{ 'sections.footer.country' | t }}</label>
                <select id="FooterCountry" name="country_code" onchange="this.form.submit()">
                  {%- for country in localization.available_countries -%}
                    <option
                      value="{{ country.iso_code }}"
                      {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
                    >
                      {{ country.name }} ({{ country.currency.iso_code }})
                    </option>
                  {%- endfor -%}
                </select>
              {%- endform -%}
            {%- endif -%}

            {%- if localization.available_languages.size > 1 -%}
              {%- form 'localization' -%}
                <label class="visually-hidden" for="FooterLanguage">{{ 'sections.footer.language' | t }}</label>
                <select id="FooterLanguage" name="locale_code" onchange="this.form.submit()">
                  {%- for language in localization.available_languages -%}
                    <option
                      value="{{ language.iso_code }}"
                      {% if language.iso_code == localization.language.iso_code %}selected{% endif %}
                    >
                      {{ language.endonym_name | capitalize }}
                    </option>
                  {%- endfor -%}
                </select>
              {%- endform -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <div class="payment">
            <span class="visually-hidden">{{ 'sections.footer.payment_methods' | t }}</span>
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'payment-icon' }}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "section-footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "info": "Sits beside the copyright line.",
      "default": "Porto · London"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_locale_selectors",
      "label": "Show country and language selectors",
      "info": "Only appear when you sell in more than one market.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "Logo width",
          "min": 80,
          "max": 300,
          "step": 5,
          "unit": "px",
          "default": 130
        },
        {
          "type": "text",
          "id": "text",
          "label": "Wordmark",
          "info": "Defaults to your store name."
        },
        {
          "type": "text",
          "id": "text_light",
          "label": "Wordmark tail"
        },
        {
          "type": "textarea",
          "id": "about",
          "label": "About",
          "default": "A twenty-four piece wardrobe, cut in Porto from mills we name."
        },
        {
          "type": "header",
          "content": "About text type"
        },
        {
          "type": "select",
          "id": "about_font",
          "label": "Font",
          "options": [
            {
              "value": "default",
              "label": "Default"
            },
            {
              "value": "heading",
              "label": "Heading font"
            },
            {
              "value": "body",
              "label": "Body font"
            },
            {
              "value": "accent",
              "label": "Accent font"
            }
          ],
          "default": "default"
        },
        {
          "type": "range",
          "id": "about_size",
          "label": "Size",
          "min": 50,
          "max": 200,
          "step": 5,
          "unit": "%",
          "default": 100
        },
        {
          "type": "color",
          "id": "about_color",
          "label": "Colour",
          "info": "Leave empty to follow the colour scheme."
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        },
        {
          "type": "header",
          "content": "Heading type"
        },
        {
          "type": "select",
          "id": "heading_font",
          "label": "Font",
          "options": [
            {
              "value": "default",
              "label": "Default"
            },
            {
              "value": "heading",
              "label": "Heading font"
            },
            {
              "value": "body",
              "label": "Body font"
            },
            {
              "value": "accent",
              "label": "Accent font"
            }
          ],
          "default": "default"
        },
        {
          "type": "range",
          "id": "heading_size",
          "label": "Size",
          "min": 50,
          "max": 200,
          "step": 5,
          "unit": "%",
          "default": 100
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Colour",
          "info": "Leave empty to follow the colour scheme."
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact details",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Find us"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "info": "Your line breaks are kept, so write it the way it would be posted."
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "info": "Shown exactly as you type it, and made tappable — spaces, brackets and dashes are stripped out of the dial link only. Include the country code for anyone calling from abroad."
        },
        {
          "type": "text",
          "id": "phone_2",
          "label": "Second phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Opening hours",
          "info": "Optional. One line, or several."
        },
        {
          "type": "header",
          "content": "Heading type"
        },
        {
          "type": "select",
          "id": "heading_font",
          "label": "Font",
          "options": [
            {
              "value": "default",
              "label": "Default"
            },
            {
              "value": "heading",
              "label": "Heading font"
            },
            {
              "value": "body",
              "label": "Body font"
            },
            {
              "value": "accent",
              "label": "Accent font"
            }
          ],
          "default": "default"
        },
        {
          "type": "range",
          "id": "heading_size",
          "label": "Size",
          "min": 50,
          "max": 200,
          "step": 5,
          "unit": "%",
          "default": 100
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Colour",
          "info": "Leave empty to follow the colour scheme."
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "House"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Text"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}
