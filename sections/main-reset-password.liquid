<div class="wrap account">
  <div class="page-head">
    <h1 class="dsp" style="font-size: calc(clamp(30px, 3.6vw, 48px) * var(--type-scale));">
      {{ 'customer.reset_password.title' | t }}
    </h1>
  </div>

  <div class="account-form">
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="form-error">
          <ul>
            {%- for field in form.errors -%}
              <li>{{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="field">
        <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
        <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
      </div>

      <div class="field">
        <label for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input
          type="password"
          id="ResetPasswordConfirm"
          name="customer[password_confirmation]"
          autocomplete="new-password"
          required
        >
      </div>

      <div>
        <button type="submit" class="b b-solid">
          {{ 'customer.reset_password.submit' | t }}
          <span class="ar">&rarr;</span>
        </button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "class": "section-reset",
  "settings": [],
  "enabled_on": {
    "templates": ["customers/reset_password"]
  }
}
{% endschema %}
