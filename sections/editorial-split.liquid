<div class="scheme color-{{ section.settings.color_scheme }}">
  {%- liquid
    assign parallax = ''
    if settings.motion_parallax
      assign parallax = ' plx'
    endif

    assign flip = ''
    if section.settings.image_position == 'right'
      assign flip = ' flip'
    endif
  -%}

  <div class="wrap">
    <div class="split{{ flip }}">
      <figure class="rv-img">
        {%- comment -%}
          A video takes the frame when one is set, and the image becomes its
          poster — the still shown while the file loads, and what stays if the
          browser refuses to autoplay. Setting both is the good case, not a
          clash, which is why the image picker is not hidden when a video is
          chosen.

          Muted and playsinline are not decoration: without muted no browser
          will autoplay at all, and without playsinline iOS takes the video
          fullscreen the moment it starts. No controls, because this sits in a
          page as a picture does, not as something to operate.

          The frame keeps its 4/3 shape either way, so the column does not
          change height with the proportions of the file uploaded, and the
          video is cropped to fill exactly as a photograph is. Reduced motion is
          handled in jogger.js, which pauses any autoplaying video on the page.
        {%- endcomment -%}
        {%- if section.settings.video != blank -%}
          <div class="media{{ parallax }}" style="--media-ratio: 4 / 3;">
            {{
              section.settings.video
              | video_tag:
                image_size: '1200x',
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true,
                poster: section.settings.image
            }}
          </div>
        {%- else -%}
          {% render 'media',
            image: section.settings.image,
            class: parallax,
            ratio: '4 / 3',
            sizes: '(min-width: 880px) 55vw, 100vw',
            placeholder: 'lifestyle-2',
            alt: section.settings.image_alt
          %}
        {%- endif -%}
      </figure>

      {%- capture label_style %}{% render 'text-style', s: section.settings, key: 'label' %}{% endcapture -%}
      {%- capture heading_style %}{% render 'text-style', s: section.settings, key: 'heading' %}{% endcapture -%}
      {%- capture body_style %}{% render 'text-style', s: section.settings, key: 'body' %}{% endcapture -%}
      {%- capture button_style %}{% render 'text-style', s: section.settings, key: 'button' %}{% endcapture -%}
      {%- capture button_colors %}{% render 'button-style', s: section.settings, key: 'button' %}{% endcapture -%}

      <div class="copy">
        {%- if section.settings.label != blank -%}
          <p class="lab rv" style="{{ label_style }}">{{ section.settings.label | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          {%- comment -%}
            Escaped before newline_to_br so the merchant's line breaks survive
            but their text can't inject markup.
          {%- endcomment -%}
          <h2 class="h2 rv" style="--i: 1;{{ heading_style }}">
            {{- section.settings.heading | escape | newline_to_br -}}
          </h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="body rte rv" style="--i: 2;{{ body_style }}">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="rv" style="--i: 3;">
            <a
              class="b b-line"
              href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
              style="{{ button_style }}{{ button_colors }}"
            >
              {{ section.settings.button_label | escape }}
              <span class="ar">&rarr;</span>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
