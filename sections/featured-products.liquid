<div class="scheme color-{{ section.settings.color_scheme }}">
  {%- liquid
    comment
      With no collection chosen, fall back to the whole catalogue rather
      than to dead placeholder cards. A freshly installed theme then shows
      real, clickable products straight away; placeholders are only for a
      store that genuinely has nothing in it yet.
    endcomment
    assign products = section.settings.collection.products
    if section.settings.collection == blank
      assign products = collections.all.products
    endif

    assign limit = section.settings.count
    assign columns = section.settings.columns

    case columns
      when 3
        assign grid_sizes = '(min-width: 1100px) 33vw, 50vw'
      when 4
        assign grid_sizes = '(min-width: 1100px) 25vw, 50vw'
      else
        assign grid_sizes = '(min-width: 1100px) 20vw, 50vw'
    endcase
  -%}

  {%- capture label_style %}{% render 'text-style', s: section.settings, key: 'label' %}{% endcapture -%}
  {%- capture heading_style %}{% render 'text-style', s: section.settings, key: 'heading' %}{% endcapture -%}
  {%- capture viewall_colors %}{% render 'button-style', s: section.settings, key: 'viewall' %}{% endcapture -%}

  <div class="wrap">
    <div class="shead rv">
      <div>
        {%- if section.settings.label != blank -%}
          <p class="lab" style="{{ label_style }}">{{ section.settings.label | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2" style="{{ heading_style }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.show_view_all and section.settings.collection != blank -%}
        <a class="b b-ghost" href="{{ section.settings.collection.url }}" style="{{ viewall_colors }}">
          {{ 'sections.collection.view_all' | t }}
          {{ section.settings.collection.products_count }}
          <span class="ar">&rarr;</span>
        </a>
      {%- endif -%}
    </div>

    <div class="pgrid" style="--cols: {{ columns }};">
      {%- if products.size > 0 -%}
        {%- for product in products limit: limit -%}
          {% render 'product-card', product: product, index: forloop.index0, sizes: grid_sizes %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}
          Nothing picked yet — show placeholder cards so the section has
          shape while the merchant sets it up. These are deliberately not
          links: there is no product to open. Without the note below that
          reads as a broken card, so say so plainly in the editor.
        {%- endcomment -%}
        {%- for i in (1..limit) -%}
          <article class="pcard is-placeholder">
            <div class="pframe">
              <span class="pshot">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</span>
            </div>
            <span class="pmeta">
              <h3>{{ 'onboarding.product_title' | t }}</h3>
              <span class="row"><span class="cat">&nbsp;</span><span class="pr">{{ 1990 | money }}</span></span>
            </span>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if request.design_mode -%}
      {%- if products.size == 0 -%}
        <p class="setup-note">{{ 'onboarding.no_products' | t }}</p>
      {%- elsif section.settings.collection == blank -%}
        <p class="setup-note">{{ 'onboarding.showing_all' | t }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product grid",
  "tag": "section",
  "class": "section-products",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "01 — Just landed"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New this week"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Products shown",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"view all\" link",
      "default": true
    },
    {
      "type": "header",
      "content": "Label type"
    },
    {
      "type": "select",
      "id": "label_font",
      "label": "Font",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "heading",
          "label": "Heading font"
        },
        {
          "value": "body",
          "label": "Body font"
        },
        {
          "value": "accent",
          "label": "Accent font"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Size",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Colour",
      "info": "Leave empty to follow the colour scheme."
    },
    {
      "type": "header",
      "content": "Heading type"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Font",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "heading",
          "label": "Heading font"
        },
        {
          "value": "body",
          "label": "Body font"
        },
        {
          "value": "accent",
          "label": "Accent font"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Size",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Colour",
      "info": "Leave empty to follow the colour scheme."
    },
    {
      "type": "header",
      "content": "View all link colours"
    },
    {
      "type": "color",
      "id": "viewall_bg",
      "label": "Fill",
      "info": "Leave empty to follow the colour scheme. On outline and underline buttons this is the line colour."
    },
    {
      "type": "color",
      "id": "viewall_fg",
      "label": "Label"
    },
    {
      "type": "color",
      "id": "viewall_hover",
      "label": "On hover"
    }
  ],
  "presets": [
    {
      "name": "Product grid"
    }
  ]
}
{% endschema %}
