<div class="wrap">
  <div class="notfound">
    <p class="lab">404</p>
    <h1 class="dsp">{{ 'templates.404.title' | t }}</h1>
    <p class="body">{{ 'templates.404.body' | t }}</p>
    <a class="b b-solid" href="{{ routes.all_products_collection_url }}">
      {{ 'templates.404.link' | t }}
      <span class="ar">&rarr;</span>
    </a>
