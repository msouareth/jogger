{%- comment -%}
  The slide-out bag.

  cart.js re-requests this section after every add or quantity change and
  swaps each [data-cart-part] into the live page, so totals, discounts and
  the free-shipping bar are always rendered by Liquid's money filters. The
  drawer shell itself is never replaced — an open drawer stays open.
{%- endcomment -%}

{%- liquid
  assign threshold = settings.cart_free_shipping_threshold | times: 100 | at_least: 0
  assign remaining = threshold | minus: cart.total_price
  assign qualified = false
  if threshold > 0 and cart.total_price >= threshold
    assign qualified = true
  endif

  assign progress = 0
  if threshold > 0
    assign progress = cart.total_price | times: 100.0 | divided_by: threshold | at_most: 100
  endif
-%}

<aside
  class="drawer"
  id="CartDrawer"
  aria-label="{{ 'sections.cart.title' | t }}"
  aria-hidden="true"
  data-cart-count="{{ cart.item_count }}"
>
  <header>
    <h2>{{ 'sections.cart.title' | t }}</h2>
    <button type="button" data-drawer-close>{{ 'general.close' | t }}</button>
  </header>

  <div class="lines" data-cart-part="lines">
    {%- if cart.item_count > 0 -%}
      {%- for item in cart.items -%}
        <div class="li" data-line-key="{{ item.key }}" style="animation-delay: {{ forloop.index0 | times: 40 }}ms;">
          <a class="th" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
            {% render 'media', image: item.image, sizes: '78px', placeholder: 'product-1' %}
          </a>

          <div>
            <h4><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h4>

            <p class="vr">
              {%- unless item.product.has_only_default_variant -%}
                <span>{{ item.variant.title | escape }}</span>
              {%- endunless -%}
              {%- for property in item.properties -%}
                {%- unless property.last == blank or property.first.first == '_' -%}
                  <span>{{ property.first | escape }}: {{ property.last | escape }}</span>
                {%- endunless -%}
              {%- endfor -%}
              {%- if item.selling_plan_allocation -%}
                <span>{{ item.selling_plan_allocation.selling_plan.name | escape }}</span>
              {%- endif -%}
            </p>

            {%- if item.line_level_discount_allocations.size > 0 -%}
              {%- for allocation in item.line_level_discount_allocations -%}
                <p class="discount">
                  {{ allocation.discount_application.title | escape }}
                  (&minus;{{ allocation.amount | money }})
                </p>
              {%- endfor -%}
            {%- endif -%}

            <div class="fr">
              <div class="qty">
                <button type="button" data-step="-1" aria-label="{{ 'products.product.decrease' | t }}">
                  {% render 'icon', name: 'minus' %}
                </button>
                <input
                  type="number"
                  data-qty
                  value="{{ item.quantity }}"
                  min="0"
                  aria-label="{{ 'sections.cart.quantity' | t }}"
                >
                <button type="button" data-step="1" aria-label="{{ 'products.product.increase' | t }}">
                  {% render 'icon', name: 'plus' %}
                </button>
              </div>

              <span class="lp">
                {%- if item.original_line_price > item.final_line_price -%}
                  <s class="was">{{ item.original_line_price | money }}</s>
                {%- endif -%}
                {{ item.final_line_price | money }}
              </span>
            </div>

            <button type="button" class="rm" data-remove>{{ 'sections.cart.remove' | t }}</button>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="empty">
        <p>{{ 'sections.cart.empty' | t }}</p>
        <a class="b b-line" href="{{ routes.all_products_collection_url }}" data-drawer-close>
          {{ 'sections.cart.continue' | t }}
          <span class="ar">&rarr;</span>
        </a>
      </div>
    {%- endif -%}
  </div>

  <footer data-cart-part="footer" {% if cart.item_count == 0 %}hidden{% endif %}>
    {%- if settings.cart_free_shipping_bar and threshold > 0 -%}
      <p class="freenote">
        {%- if qualified -%}
          {{ 'sections.cart.free_shipping_reached' | t }}
        {%- else -%}
          {%- assign remaining_money = remaining | money -%}
          {{ 'sections.cart.free_shipping_progress' | t: amount: remaining_money }}
        {%- endif -%}
      </p>
      <div class="prog">
        <i style="width: {{ progress }}%;"></i>
      </div>
    {%- endif -%}

    {%- if settings.cart_notes -%}
      <details class="cart-note">
        <summary>{{ 'sections.cart.note' | t }}</summary>
        <textarea
          data-cart-note
          name="note"
          placeholder="{{ 'sections.cart.note_placeholder' | t }}"
          aria-label="{{ 'sections.cart.note' | t }}"
        >{{ cart.note }}</textarea>
      </details>
    {%- endif -%}

    <div class="tot">
      <span>{{ 'sections.cart.subtotal' | t }}</span>
      <span>{{ cart.items_subtotal_price | money }}</span>
    </div>

    {%- for discount in cart.cart_level_discount_applications -%}
      <div class="tot">
        <span>{{ discount.title | escape }}</span>
        <span>&minus;{{ discount.total_allocated_amount | money }}</span>
      </div>
    {%- endfor -%}

    <div class="tot">
      <span>{{ 'sections.cart.shipping' | t }}</span>
      <span>
        {%- if qualified -%}
          {{ 'sections.cart.shipping_free' | t }}
        {%- else -%}
          {{ 'sections.cart.shipping_at_checkout' | t }}
        {%- endif -%}
      </span>
    </div>

    <div class="tot sum">
      <span>{{ 'sections.cart.total' | t }}</span>
      <b>{{ cart.total_price | money_with_currency }}</b>
    </div>

    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="b b-solid">
        {{ 'sections.cart.checkout' | t }}
        <span class="ar">&rarr;</span>
      </button>
    </form>

    <p class="fine">{{ 'sections.cart.taxes_note' | t }}</p>
  </footer>
</aside>

{% schema %}
{
  "name": "Bag drawer",
  "settings": []
}
{% endschema %}
