{%- liquid
  assign hero_image = section.settings.image

  comment
    Whole-image mode gives the frame the picture's own proportions instead of a
    fixed height, so filling it crops nothing. It needs a real image to take a
    ratio from — the placeholder has none, so the fixed height stands in.
  endcomment
  assign whole = false
  if section.settings.image_fit == 'whole' and hero_image != blank
    assign whole = true
  endif

  comment
    The drift is a slow zoom, so it is a crop by definition. Asking to see the
    whole image and asking to zoom into it are contradictory; the explicit
    choice wins.
  endcomment
  assign drift = ''
  if settings.motion_kenburns and whole == false
    assign drift = ' kb'
  endif

  assign frame_class = 'hero-frame'
  if whole
    assign frame_class = 'hero-frame hero-frame--whole'
  endif
-%}

<div class="scheme color-{{ section.settings.color_scheme }}">
<div class="hero">
  <div
    class="{{ frame_class }}"
    style="--hero-height: {{ section.settings.height }}vh; --veil: {{ section.settings.veil | divided_by: 100.0 }};{% if whole %} --hero-ratio: {{ hero_image.aspect_ratio }};{% endif %}"
  >
    {% render 'media',
      image: section.settings.image,
      class: drift,
      sizes: '100vw',
      loading: 'eager',
      fetchpriority: 'high',
      placeholder: 'lifestyle-1',
      alt: section.settings.image_alt
    %}

    <div class="hero-veil"></div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'hotspot' -%}
          {%- assign spot_product = block.settings.product -%}
          {%- if spot_product != blank -%}
            <a
              class="spot"
              href="{{ spot_product.url }}"
              style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;"
              aria-label="{{ 'products.product.view' | t: title: spot_product.title }}"
              {{ block.shopify_attributes }}
            >
              <i aria-hidden="true"></i>
              <span class="tip">
                <b>{{ spot_product.title | escape }}</b>
                <span>{% render 'price', product: spot_product %}</span>
              </span>
            </a>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}

    {%- assign pill_blocks = section.blocks | where: 'type', 'pill' -%}
    {%- if pill_blocks.size > 0 -%}
      <div class="hero-side">
        {%- for block in pill_blocks -%}
          <span class="pill" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- capture label_style %}{% render 'text-style', s: section.settings, key: 'label' %}{% endcapture -%}
    {%- capture heading_style %}{% render 'text-style', s: section.settings, key: 'heading' %}{% endcapture -%}
    {%- capture body_style %}{% render 'text-style', s: section.settings, key: 'body' %}{% endcapture -%}
    {%- capture button_style %}{% render 'text-style', s: section.settings, key: 'button' %}{% endcapture -%}
    {%- capture button_colors %}{% render 'button-style', s: section.settings, key: 'button' %}{% endcapture -%}

    <div class="hero-card">
      {%- if section.settings.label != blank -%}
        <p class="lab" style="{{ label_style }}">{{ section.settings.label | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="dsp" style="{{ heading_style }}">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p style="{{ body_style }}">{{ section.settings.body | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          class="b b-paper"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          style="{{ button_style }}{{ button_colors }}"
        >
          {{ section.settings.button_label | escape }}
          <span class="ar">&rarr;</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>
</div>

