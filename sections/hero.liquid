    {
      "type": "select",
      "id": "image_fit",
      "label": "Image",
      "info": "Filling the frame keeps the hero the same height on every screen, and crops the picture to fit — a wide screen crops more off the top and bottom than a narrow one. Showing the whole picture instead gives the frame the picture's own proportions, so nothing is cropped, but the hero's height then changes with the shape of the image you upload and the Height setting no longer applies. The slow zoom is also turned off, since it is a crop.",
      "options": [
        { "value": "fill", "label": "Fill the frame (crops to fit)" },
        { "value": "whole", "label": "Show the whole picture" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "info": "As a share of the screen height, clamped between 460 and 820px. Only applies when the image fills the frame.",
