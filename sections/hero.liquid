      "max": 95,
      "step": 1,
      "unit": "%",
      "default": 78
    },
    {
      "type": "range",
      "id": "veil",
      "label": "Shading",
      "info": "Darkens the foot of the image so the text stays legible.",
      "min": 0,
      "max": 85,
      "step": 5,
