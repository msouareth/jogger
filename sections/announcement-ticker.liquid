<div class="scheme color-{{ section.settings.color_scheme }}">
  {%- comment -%}
    The scrolling band above the header. jogger.js duplicates the track so the
    -50% keyframe loops seamlessly; the duplicate is hidden from assistive
    tech and the messages are announced once from the list below instead.
  {%- endcomment -%}

  {%- if section.blocks.size > 0 -%}
    <div class="ticker" style="--tick-speed: {{ section.settings.speed }}s;">
      <div class="tick-run" aria-hidden="true">
        {%- for block in section.blocks -%}
          {%- capture text_style %}{% render 'text-style', s: block.settings, key: 'text' %}{% endcapture -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" tabindex="-1" style="{{ text_style }}">
              {{- block.settings.text | escape -}}
            </a>
          {%- else -%}
            <span style="{{ text_style }}">{{ block.settings.text | escape }}</span>
          {%- endif -%}
          <span>&middot;</span>
        {%- endfor -%}
      </div>

      <ul class="visually-hidden">
        {%- for block in section.blocks -%}
          <li>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              {{ block.settings.text | escape }}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Announcement ticker",
  "tag": "section",
  "class": "section-ticker",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds per loop",
      "info": "Higher is slower. The band pauses on hover.",
      "min": 16,
      "max": 90,
      "step": 2,
      "unit": "s",
      "default": 34
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Complimentary shipping over $150"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Message type"
        },
        {
          "type": "select",
          "id": "text_font",
          "label": "Font",
          "options": [
            {
              "value": "default",
              "label": "Default"
            },
            {
              "value": "heading",
              "label": "Heading font"
            },
            {
              "value": "body",
              "label": "Body font"
            },
            {
              "value": "accent",
              "label": "Accent font"
            }
          ],
          "default": "default"
        },
        {
          "type": "range",
          "id": "text_size",
          "label": "Size",
          "min": 50,
          "max": 200,
          "step": 5,
          "unit": "%",
          "default": 100
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Colour",
          "info": "Leave empty to follow the colour scheme."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement ticker",
      "blocks": [
        {
          "type": "message"
        },
        {
          "type": "message",
          "settings": {
            "text": "30-day returns, always"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Cut and sewn in Porto"
          }
        }
      ]
    }
  ]
}
{% endschema %}
